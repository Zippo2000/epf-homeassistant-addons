# Template for the local, git-IGNORED ./.env consumed by run-live-tests.sh.
# Copy this to ./.env and fill in real values. ./.env is git-ignored; never
# commit real credentials or a real LAN address.
#
#   cp .env.example .env   # then edit .env
IMMICH_API_KEY=your-immich-api-key-with-asset-download-grant
IMMICH_URL=http://192.168.1.100:2283
IMMICH_ALBUM=<your-album-name>

# Live ComfyUI tier (TC-L09/L10, 2.4.0). The workflow JSON is optional and only
# needed for the real-export test: paste what ComfyUI's "Save (Export)" produces.
COMFYUI_URL=http://192.168.1.100:8188
COMFYUI_WORKFLOW_JSON=
